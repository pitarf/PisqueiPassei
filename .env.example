# Conexão com o Banco de Dados PostgreSQL
DATABASE_URL="postgresql://transpetro_user:transpetro_pass@localhost:5432/transpetro_study?schema=public"

# Provedor de IA (Google Gemini API)
GEMINI_API_KEY="insira_sua_chave_gemini_aqui"

# Provedor Alternativo (Opcional - OpenAI / OpenRouter)
OPENAI_API_KEY="insira_sua_chave_openai_aqui"

# Configuração de Ambiente
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
